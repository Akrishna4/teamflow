# ==============================================================
# TEAMFLOW PRODUCTION ENVIRONMENT VARIABLES
# Copy this file to your hosting provider's environment settings
# ==============================================================

# --------------------------------------------------------------
# BACKEND (.env for Render / Node server)
# --------------------------------------------------------------

# Environment mode (must be production)
NODE_ENV=production

# The port the backend runs on (Render sets this automatically)
PORT=5000

# MongoDB Atlas connection string (replace credentials)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/teamflow?retryWrites=true&w=majority

# Secret key for signing JWTs (must be long and random)
JWT_SECRET=generate_a_secure_random_string_here_min_64_chars

# Authorized frontend domain (Vercel URL)
CORS_ORIGIN=https://teamflow-app.vercel.app

# Logging level (info or warn recommended for production)
LOG_LEVEL=info

# --------------------------------------------------------------
# FRONTEND (.env for Vercel / Vite build)
# --------------------------------------------------------------

# URL for the backend API
VITE_API_URL=https://teamflow-api.onrender.com/api

# URL for the WebSocket connection (typically same as backend root)
VITE_SOCKET_URL=https://teamflow-api.onrender.com
